{
  "name": "site-regret",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/prepare-data.ts && node scripts/geospatial/publish-terrain.ts && node scripts/engine/publish-engineer-heights.ts",
    "geo:fetch": "node scripts/geospatial/fetch-originals.ts",
    "geo:build": "node scripts/geospatial/build-terrain.ts",
    "geo:coregistration": "node scripts/geospatial/check-coregistration.ts",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.ts out",
    "serve": "node scripts/serve-static.ts out 4173",
    "pretest": "npm run data",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "ol": "^10.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "geotiff": "^3.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "description": "SITE REGRET — comparador lunar A/B sobre resultados científicos precalculados (NASA Space Apps 2026, QuemandoTokens)",
  "engines": {
    "node": ">=22.18"
  }
}
